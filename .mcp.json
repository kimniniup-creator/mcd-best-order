{
  "mcpServers": {
    "coupon-split": {
      "command": "node",
      "args": [
        "-e",
        "require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT || process.cwd(), 'hooks', 'launch.cjs'))",
        "server"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "startup_timeout_sec": 120,
      "required": false,
      "env_vars": [
        "MCD_MCP_TOKEN",
        "COUPON_SPLIT_HOME",
        "ALLOW_REAL_ORDERS",
        "AMAP_KEY",
        "COUPON_SPLIT_SIMULATE",
        "UV_CACHE_DIR",
        "PYTHON_KEYRING_BACKEND"
      ],
      "cwd": "."
    }
  }
}
