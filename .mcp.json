{
  "mcpServers": {
    "coupon-split": {
      "command": "sh",
      "args": [
        "-c",
        "if [ -n \"$CLAUDE_PLUGIN_ROOT\" ]; then exec sh \"$CLAUDE_PLUGIN_ROOT/hooks/launch.sh\" server; else exec sh hooks/launch.sh server; fi"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "startup_timeout_sec": 120,
      "required": false,
      "env_vars": [
        "MCD_MCP_TOKEN",
        "COUPON_SPLIT_HOME",
        "ALLOW_REAL_ORDERS",
        "COUPON_SPLIT_SIMULATE",
        "UV_CACHE_DIR",
        "PYTHON_KEYRING_BACKEND"
      ],
      "cwd": "."
    }
  }
}
