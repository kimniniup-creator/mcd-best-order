{
  "revision": "2026-10-28",
  "about": "麦当劳点餐用语本体。概念只存词面、类型、关系和菜单名称模式；不存价格和商品码，运行时按门店实时菜单落地。",
  "types": {
    "Product": "单品，按名称模式落到菜单",
    "Family": "商品族，族内按菜单选或由引擎求最优",
    "Combo": "固定套餐",
    "Ambiguous": "一个词面对应多个概念，必须追问",
    "Membership": "会员卡，不是餐品",
    "Activity": "促销活动，以当前官方活动为准",
    "Service": "服务，不是餐品",
    "Brand": "麦当劳品牌称呼，不是餐品",
    "OtherBrand": "其他品牌的说法",
    "Unsupported": "查不到官方依据的说法"
  },
  "relations": {
    "broader": "上位概念；不在售时在同一上位概念下找替代",
    "narrower": "多义词面指向的候选概念",
    "hasMain": "套餐的主食概念",
    "cardVariant": "菜单展示含卡价与不带卡价",
    "availableIn": "供应时段",
    "askWhenSiblings": "菜单上同时出现这些名称时，把该词面视为歧义"
  },
  "model": {
    "about": "点餐本体的结构部分：实体、槽位、约束、订单状态图。词汇概念在下面的 concepts。宿主 Agent 理解用户原话后，按槽位把理解传给 resolve_order；服务端用真实数据落地并逐条检查约束，不替宿主决定说什么、先做什么。",
    "entities": {
      "Store": {"label": "门店", "fields": ["storeCode", "name", "distance", "businessWindow", "reservationWindows"], "source": "麦当劳门店查询（按地标或按已保存地址）"},
      "Fulfillment": {"label": "取餐方式", "values": {
        "pickup": {"label": "到店自取", "aliases": ["自取", "到店", "去拿", "堂食", "外带"], "storeQuery": "nearby", "needs": ["city", "landmark"]},
        "drive": {"label": "得来速", "aliases": ["得来速", "开车", "开车去"], "storeQuery": "nearby", "needs": ["city", "landmark"]},
        "delivery": {"label": "麦乐送外送", "aliases": ["外送", "外卖", "送到", "麦乐送", "送过来"], "storeQuery": "address", "needs": ["address"]}
      }},
      "DeliveryAddress": {"label": "外送地址", "rule": "只能是账户里已保存的地址；用户的说法（地标、门号、别名）与已保存地址比对，不新建、不改写。", "matchBy": "用户说法里的区分性片段与已保存地址文本的重合", "aliases": {"学校": ["大学", "学院", "校区", "中学", "小学"], "公司": ["大厦", "广场", "科技", "园区", "中心", "写字楼", "产业园"], "家": ["小区", "花园", "苑", "公寓", "家园", "里", "村"]}},
      "TimeWindow": {"label": "时间窗", "kinds": {"immediate": "现在就取/送", "reserve": "预约到某天某时"}, "source": "门店返回的 reservationTimeOptions 与营业时段"},
      "Item": {"label": "商品", "grounding": "词面经 concepts 落到门店实时菜单；价格与商品码只来自菜单"},
      "ComboSlot": {"label": "套餐选配槽", "rule": "每个选配槽有官方候选与数量范围；用户没说的槽用官方默认项并告诉用户"},
      "Spec": {"label": "规格", "axes": {"size": ["大杯", "中杯", "小杯", "大份", "中份", "小份"], "temperature": ["热", "冰", "去冰", "少冰", "多冰", "常温"], "flavor": []}, "rule": "规格严格等价：只接受官方选项里有的规格；没有就说明并列出官方候选，不换成相近的"},
      "Alias": {"label": "黑话别名", "ref": "concepts"}
    },
    "slots": {
      "fulfillment": {"entity": "Fulfillment", "values": ["pickup", "drive", "delivery"], "sources": ["user_utterance", "saved_data", "default"],
        "ask": "用户原话没有表达取餐方式、也没有可信的已保存选择时必须问", "default": "原话里有地址且是账户已保存的外送地址、或明说送到/外送 → delivery；明说自取/到店 → pickup"},
      "city": {"entity": "Store", "values": "城市名", "sources": ["user_utterance", "saved_data"], "ask": "自取或得来速且无法从地标判断城市时必须问", "default": "沿用本会话上一次的城市"},
      "landmark": {"entity": "Store", "values": "地标、小区、街道", "sources": ["user_utterance", "device_location"], "ask": "自取或得来速且没有地标、也没有定位时必须问", "default": "无"},
      "address": {"entity": "DeliveryAddress", "values": "账户已保存地址之一", "sources": ["user_utterance", "saved_data"], "ask": "外送且用户的说法对上不止一个已保存地址、或一个也对不上时必须问", "default": "账户只有一个已保存地址且用户已明说外送：仍然列出让用户确认，不替用户默认"},
      "store": {"entity": "Store", "values": "门店查询返回的门店", "sources": ["lookup"], "ask": "候选超过一家且用户对距离或店名有偏好时才问", "default": "最近的一家，并告诉用户是哪家"},
      "time": {"entity": "TimeWindow", "values": ["immediate", "reserve"], "sources": ["user_utterance", "default"], "ask": "用户说的时间不在门店可选时段内，或说法含糊（几点、上午下午）时必须问", "default": "没提时间 → immediate"},
      "items": {"entity": "Item", "values": "菜单商品加数量", "sources": ["user_utterance", "saved_data"], "ask": "词面对应多个商品、对应不到商品、或规格没有官方选项时必须问；只说想吃没有指明时先问想吃什么", "default": "套餐选配槽没说时用官方默认项"},
      "spec": {"entity": "Spec", "values": "官方选项", "sources": ["user_utterance", "default"], "ask": "用户给的规格官方没有时必须问", "default": "没提规格 → 官方默认"},
      "people": {"entity": "Item", "values": "1 到 12", "sources": ["user_utterance"], "ask": "帮我配且没说人数时可以问", "default": "1"},
      "avoid": {"entity": "Item", "values": "忌口列表", "sources": ["user_utterance"], "ask": "不问", "default": "无"},
      "tableware": {"entity": "Item", "values": [true, false], "sources": ["user_utterance", "default"], "ask": "不问", "default": "false（不需要餐具）"},
      "takeWay": {"entity": "Fulfillment", "values": "报价返回的堂食或外带", "sources": ["user_utterance", "lookup"], "ask": "得来速和自取报价后用户没说堂食或外带时必须问", "default": "无"}
    },
    "constraints": {
      "STORE_NOT_FOUND": {"slot": "store", "fact": "按「{landmark}」在{city}没有查到可用门店。", "alternative": "换一个更具体的地标或小区"},
      "STORE_CLOSED": {"slot": "store", "fact": "{store}现在不营业，营业时间 {hours}。", "alternative": "预约营业时段内的时间，或换一家门店"},
      "TIME_UNCLEAR": {"slot": "time", "fact": "用户说的时间不完整或有歧义：{detail}", "alternative": "问用户具体的日期和时刻，例如“明天中午12点半”"},
      "TIME_IN_PAST": {"slot": "time", "fact": "{time} 已经过去了（现在是 {now}）。", "alternative": "给一个晚于现在的时间"},
      "TIME_OUTSIDE_WINDOW": {"slot": "time", "fact": "{store}在{date}可预约的时段是：{windows}；{time} 不在其中。", "alternative": "从这些时段里选一个时间"},
      "IMMEDIATE_NOT_AVAILABLE": {"slot": "time", "fact": "{store}现在（{now}）不在可下单时段内，当天可预约的时段是：{windows}。", "alternative": "选这些时段内的一个时间，或改天"},
      "ADDRESS_NOT_SAVED": {"slot": "address", "fact": "外送地址必须是账户里已保存的地址；「{hint}」没有对上任何一个。已保存的地址有 {count} 个。", "alternative": "从已保存地址里选一个，或让用户先在麦当劳 App 里保存新地址"},
      "ADDRESS_AMBIGUOUS": {"slot": "address", "fact": "「{hint}」同时对上了 {count} 个已保存地址。", "alternative": "让用户指出是哪一个"},
      "ITEM_NOT_FOOD": {"slot": "items", "fact": "「{phrase}」{note}", "alternative": "问用户想吃什么餐品"},
      "ITEM_NOT_FOUND": {"slot": "items", "fact": "「{phrase}」在{store}当前菜单里没有对上任何商品。", "alternative": "问用户想点的具体餐品，可以列出菜单里相近的类别"},
      "ITEM_SOLD_OUT": {"slot": "items", "fact": "「{phrase}」对应的商品在{store}当前不在售或已售罄。", "alternative": "同类在售商品：{alternatives}"},
      "ITEM_AMBIGUOUS": {"slot": "items", "fact": "「{phrase}」在{store}对应多个商品：{options}。", "alternative": "问用户是哪一个"},
      "ITEM_NOT_OFFERED_FOR_WAY": {"slot": "items", "fact": "{detail}", "alternative": "换一道餐品，或改一种取餐方式再查"},
      "SPEC_NOT_OFFERED": {"slot": "spec", "fact": "「{phrase}」没有「{spec}」这个官方规格；官方选项是：{options}。", "alternative": "问用户选哪一个官方选项，规格不近似替换"},
      "FULFILLMENT_STORE_MISMATCH": {"slot": "fulfillment", "fact": "这家店是按「{store_way}」查到的，和现在的取餐方式「{way}」不一致。", "alternative": "按新的取餐方式重新查门店"},
      "AMOUNT_OVER_LIMIT": {"slot": "items", "fact": "这一单报价超过 ¥200，确认时必须带金额。", "alternative": "确认句写成「确认下单 ¥金额」"},
      "PEOPLE_RANGE": {"slot": "people", "fact": "人数 {people} 不在 1 到 12 之间。", "alternative": "让用户确认人数"}
    },
    "states": {
      "start": {"about": "还没有会话或购物车", "replyRequires": ["setup_url"], "actions": ["mcd_start", "resolve_order", "account_info", "delivery_addresses", "find_store"]},
      "collecting": {"about": "已有会话，缺门店或缺餐品", "actions": ["resolve_order", "mcd_start", "find_store", "delivery_addresses", "get_location", "get_menu", "account_info"]},
      "store_ready": {"about": "门店已定、餐品未定", "actions": ["resolve_order", "get_menu", "get_item_detail", "propose_cart", "mcd_start", "get_cart"]},
      "picking": {"about": "点餐页已生成，等用户在页面里选好并提交", "replyRequires": ["picker_url"], "actions": ["get_cart", "resolve_order", "mcd_start", "get_menu"]},
      "items_ready": {"about": "餐品已定、尚未报价（用户还没有看到价格，报价之前不能确认下单；核价只向麦当劳问价，不产生订单、不扣款）", "actions": ["quote_best", "preview_selection", "get_item_detail", "resolve_order", "get_menu", "mcd_start"]},
      "proposed": {"about": "已给出主推和备选，等用户认可", "actions": ["mcd_start", "propose_cart", "get_menu", "get_item_detail", "resolve_order"]},
      "blocked": {"about": "有未解决的约束违反，先解决才能报价", "actions": ["resolve_order", "mcd_start", "find_store", "delivery_addresses", "get_menu"]},
      "quoted": {"about": "已报价，等用户确认", "replyRequires": ["pay_yuan"], "actions": ["place_orders", "withdraw_order", "cancel_plan", "get_options", "get_evidence", "quote_best", "resolve_order"],
        "preconditions": {"place_orders": "用户本轮最后一句是标准确认句，且带上报价的 plan_id 和 confirm_token"}},
      "confirm_required": {"about": "确认页已生成，等用户在页面或弹窗里确认", "replyRequires": ["confirm_url"], "actions": ["place_orders", "withdraw_order"]},
      "placing": {"about": "正在创建订单", "actions": ["wait_payment", "withdraw_order"]},
      "verifying": {"about": "正在核对下单结果", "actions": ["wait_payment", "withdraw_order"]},
      "rollback_pending": {"about": "撤回尚未成功，系统在重试", "actions": ["wait_payment", "withdraw_order"]},
      "awaiting_payment": {"about": "订单已建，等用户本人付款", "replyRequires": ["payment_url"], "actions": ["pay_card", "wait_payment", "withdraw_order"]},
      "cancelled": {"about": "已撤回或放弃", "terminal": true, "actions": ["mcd_start", "resolve_order"]},
      "paid": {"about": "已付款", "terminal": true, "actions": ["mcd_start", "resolve_order"]},
      "place_failed": {"about": "下单没有成功", "terminal": true, "actions": ["mcd_start", "resolve_order", "withdraw_order"]},
      "completed": {"about": "已完成", "terminal": true, "actions": ["mcd_start", "resolve_order"]},
      "awaiting_coupon_return": {"about": "已撤回，等券退回", "terminal": true, "actions": ["wait_payment", "mcd_start"]},
      "partially_completed": {"about": "部分订单已付款", "terminal": true, "actions": ["mcd_start", "resolve_order"]},
      "expired": {"about": "已过期", "terminal": true, "actions": ["mcd_start", "resolve_order"]}
    },
    "replyRequiresAbout": "这些字段的内容用户必须在你的回复里看到：用户看不到工具返回，只看得到你发的消息；服务端无法看到你的回复，也不代为转达",
    "invariants": [
      "真实下单只认人工确认：确认页上的点击，或确认弹窗里填回与报价一致的实付金额后接受",
      "不得代造、拼接或补写用户的确认原文，user_confirmation 只能逐字复制用户最后一条消息",
      "撤回随时可用：用户表达不想要的意思，就调用 withdraw_order，并如实转告结果",
      "价格、优惠、规格、拆单只来自服务端对麦当劳的实时计价，不自行编价或承诺最低",
      "外送地址只能是账户已保存的地址，不创建、不改写",
      "付款由用户本人完成"
