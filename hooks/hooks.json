{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(get_cart|place_orders)|mcp__(plugin_mcd-best-order_coupon-split|coupon-split)__(wait_payment|pay_card|withdraw_order)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" check",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
