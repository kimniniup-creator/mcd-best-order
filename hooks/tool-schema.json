  {
    "name": "mcd_start",
    "description": "开始或修改一单麦当劳点餐。utterance 逐字传用户本轮原话，foods 传你理解出的餐品。\n服务端从原话里读取取餐方式、外送地址、时间，并对上账户已保存的地址和门店的预约时段；\n返回已确定的、缺的（missing）和违反的约束（violations）。更细的槽位用 resolve_order 传入。\n缺授权时返回本机授权页 setup_url；授权在本机页面完成，不在聊天里索要 Token，不创建地址。\n",
    "inputSchema": {
      "properties": {
        "utterance": {
          "description": "逐字复制本轮最后一条用户消息。严禁拼接上一轮原话、历史摘要、已知餐品或要素；历史由服务端自动保留。",
          "title": "Utterance",
          "type": "string"
        },
        "recommend": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "用户明确要你配餐时才为 true；用户已说出具体餐品或黑话时不填",
          "title": "Recommend"
        },
        "plan": {
          "anyOf": [
            {
              "enum": [
                "帮我配",
                "我自己点",
                "照上次那份"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "用户明确说了其中一种才填；用户只是说出餐品时不填",
          "title": "Plan"
        },
        "session_id": {
          "default": "",
          "description": "同一对话后续每轮传前一轮返回的 session_id（不传则开启新会话，丢失人数、预算、忌口；传了不存在的 id 不会新开会话，只返回事实和最近的有效会话）；全新对话留空。",
          "title": "Session Id",
          "type": "string"
        },
        "foods": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选。结合上下文理解本轮用户真正要点的餐品，每项一个标准餐品名加数量，如 [\"麦辣鸡腿堡 2份\",\"中薯\"]；“刚才那个”“再来一份一样的”换成具体餐品，“不要麦辣的”这类否定的餐品不写，错别字写正确名称。本轮没提餐品就不传。utterance 仍逐字传原话。",
          "title": "Foods"
        }
      },
      "required": [
        "utterance"
      ],
      "title": "mcd_startArguments",
      "type": "object"
    },
