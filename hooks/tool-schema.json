[
  {
    "name": "find_store",
    "description": "按城市、地标和取餐方式查门店；外送按账户已保存的地址（address_id）查。不从地址簿擅自推断用户想外送。",
    "inputSchema": {
      "properties": {
        "city": {
          "title": "City",
          "type": "string"
        },
        "keyword": {
          "default": "",
          "title": "Keyword",
          "type": "string"
        },
        "fulfillment": {
          "default": "pickup",
          "enum": [
            "pickup",
            "drive",
            "delivery"
          ],
          "title": "Fulfillment",
          "type": "string"
        },
        "address_id": {
          "default": "",
          "title": "Address Id",
          "type": "string"
        },
        "session_id": {
          "default": "",
          "title": "Session Id",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "enum": [
                "帮我配",
                "我自己点",
                "照上次那份"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "utterance": {
          "default": "",
          "title": "Utterance",
          "type": "string"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "city"
      ],
      "title": "find_storeArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "resolve_order",
    "description": "把你对用户原话的理解，按点餐本体的槽位（取餐方式、城市与地标或外送地址的说法、时间、餐品与规格、人数、忌口）传进来。\n服务端用账户已保存的地址、门店的营业与预约时段、实时菜单和官方规格逐项核对，返回：\nresolved（每个槽位的值和来源）、ambiguous（候选和区分候选要问的事实）、missing（必须问用户的槽位）、\nviolations（违反的约束：reason_code、事实、可行替代）、state 和 allowed_actions。\n用户没说的槽位不要填；可以重复调用，每次带上这一单完整的 foods。\n",
    "inputSchema": {
      "$defs": {
        "Food": {
          "properties": {
            "phrase": {
              "description": "用户说的餐品，保持用户的词（黑话、简称、错别字都行）；规格词可以留在里面",
              "title": "Phrase",
              "type": "string"
            },
            "quantity": {
              "anyOf": [
                {
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "数量；用户没说就不填",
              "title": "Quantity"
            },
            "spec": {
              "description": "规格，如 大杯、去冰",
              "items": {
                "type": "string"
              },
              "title": "Spec",
              "type": "array"
            }
          },
          "required": [
            "phrase"
          ],
          "title": "Food",
          "type": "object"
        },
        "Interpretation": {
          "description": "Your reading of what the user said, slot by slot. Leave out whatever the user did not say.",
          "properties": {
            "fulfillment": {
              "anyOf": [
                {
                  "enum": [
                    "pickup",
                    "drive",
                    "delivery"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "取餐方式：pickup 到店自取，drive 得来速，delivery 外送",
              "title": "Fulfillment"
            },
            "city": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "城市（自取、得来速查门店用）",
              "title": "City"
            },
            "landmark": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "地标、小区或街道（自取、得来速）",
              "title": "Landmark"
            },
            "address": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "外送时用户对地址的说法，原样转述，如“北二门那个地址”“公司”；服务端会对上账户已保存的地址",
              "title": "Address"
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/When"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "取餐或送达时间；用户没提时间就不填（默认立即）"
            },
            "foods": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/Food"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "这一单完整的餐品清单（会替换之前的）；本轮没提餐品就不填",
              "title": "Foods"
            },
            "people": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "几个人吃",
              "title": "People"
            },
            "avoid": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "忌口",
              "title": "Avoid"
            },
            "plan": {
              "anyOf": [
                {
                  "enum": [
                    "帮我配",
                    "我自己点",
                    "照上次那份"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "用户要你配餐、自己在点餐页点，还是照上次",
              "title": "Plan"
            },
            "tableware": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "是否要餐具",
              "title": "Tableware"
            },
            "take_way": {
              "anyOf": [
                {
                  "enum": [
                    "eat-in",
                    "take-in-store"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "堂食 eat-in 或外带 take-in-store",
              "title": "Take Way"
            }
          },
          "title": "Interpretation",
          "type": "object"
        },
        "When": {
          "properties": {
            "kind": {
              "default": "immediate",
              "enum": [
                "immediate",
                "reserve"
              ],
              "title": "Kind",
              "type": "string"
            },
            "text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "用户说的预约时间原话，如“明天中午12点半”；由服务端解析",
              "title": "Text"
            },
            "at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "你已经算出的预约时间，上海时间 YYYY-MM-DD HH:MM；与 text 二选一",
              "title": "At"
            }
          },
          "title": "When",
          "type": "object"
        }
      },
      "properties": {
        "utterance": {
          "description": "逐字复制本轮最后一条用户消息；历史由服务端保留，不要拼接",
          "title": "Utterance",
          "type": "string"
        },
        "interpretation": {
          "$ref": "#/$defs/Interpretation"
        },
        "session_id": {
          "default": "",
          "description": "同一对话后续每轮传前一轮返回的 session_id；新对话留空",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "utterance",
        "interpretation"
      ],
      "title": "resolve_orderArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
