[
  {
    "name": "find_store",
    "description": "mcd_start 后，按用户给出的城市、地标和方式查询门店；不能从地址簿擅自推断用户想外送。",
    "inputSchema": {
      "properties": {
        "city": {
          "title": "City",
          "type": "string"
        },
        "keyword": {
          "default": "",
          "title": "Keyword",
          "type": "string"
        },
        "fulfillment": {
          "default": "pickup",
          "enum": [
            "pickup",
            "drive",
            "delivery"
          ],
          "title": "Fulfillment",
          "type": "string"
        },
        "address_id": {
          "default": "",
          "title": "Address Id",
          "type": "string"
        },
        "session_id": {
          "default": "",
          "title": "Session Id",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "enum": [
                "帮我配",
                "我自己点",
                "照上次那份"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "utterance": {
          "default": "",
          "title": "Utterance",
          "type": "string"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "city"
      ],
      "title": "find_storeArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
