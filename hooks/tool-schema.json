  {
    "name": "propose_cart",
    "description": "提交一个主推和一个备选：[{title,reason,items:[{productCode,quantity,roundList?,modification?}]}]。\n服务端校验菜单、时段、忌口、官方选配和照原样价，逐个方案返回通过与否及原因；成功只更新本地购物车，方案经用户认可后才可报价。\n",
    "inputSchema": {
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "options": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Options",
          "type": "array"
