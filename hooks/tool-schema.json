  {
    "name": "propose_cart",
    "description": "提交一个主推+一个备选：[{title,reason,items:[{productCode,quantity,roundList?,modification?}]}]。\n校验菜单/时段/忌口/官方选配和照原样价；错误按原因重配。成功只更新本地购物车。\n原样展示后停止等用户“就这样”“换备选”或修改；认可后 mcd_start → quote_best，禁止自主下单。\n",
    "inputSchema": {
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "options": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "options"
      ],
      "title": "propose_cartArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
