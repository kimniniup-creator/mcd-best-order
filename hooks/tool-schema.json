  {
    "name": "mcd_start",
    "description": "用户一提到想吃/点麦当劳（如“我要吃麦当劳”），立刻调用本工具，不要先追问；开始或修改点餐、继续刚才的餐品；报价后的“确认”“确认下单 ¥金额”必须直接调用 place_orders，绝不调用本工具。无需用 shell 读取 SKILL.md。\n\n每轮逐字传用户原话；同一对话后续轮传前一轮 session_id，新对话留空。\n按 next_tool 和 next_arguments 同回合继续，只追问 missing。\n原样展示 display_markdown（中文，禁止英文元话）。先向用户发出点餐页链接，\n再 get_cart(wait=25,link_displayed=true)，同一回合链接只发一次，超时继续等。\n收到 submitted 自动 quote_best；收到“好了”仍调用本工具恢复。\n报价完整展示后停等明确确认；place_orders 逐字传用户最后一句，宿主有审批时仍须允许，不得自主下单。\n缺授权只给本机 setup_url，绝不索要聊天 Token；禁止创建地址。\n",
    "inputSchema": {
      "properties": {
        "utterance": {
          "description": "逐字复制本轮最后一条用户消息。严禁拼接上一轮原话、历史摘要、已知餐品或要素；历史由服务端自动保留。",
          "title": "Utterance",
          "type": "string"
        },
        "recommend": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommend"
        },
        "plan": {
          "anyOf": [
            {
              "enum": [
                "帮我配",
                "我自己点",
                "照上次那份"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "session_id": {
          "default": "",
          "description": "同一对话后续每轮必填：复制前一轮返回的 session_id，否则会开启新会话并丢失人数/预算/忌口。仅全新对话留空，禁止查询或猜旧 ID。",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "utterance"
      ],
      "title": "mcd_startArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
